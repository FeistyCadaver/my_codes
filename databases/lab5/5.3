-- Представление с агрегатными функциями
CREATE VIEW v_doctor_statistics AS
SELECT 
    d.d_name AS doctor_name,
    d.spec AS specialization,
    COUNT(a.appointment_id) AS total_appointments,
    AVG(a.visit_cost) AS avg_visit_cost,
    SUM(a.visit_cost) AS total_revenue,
    AVG(CAST(a.satisfaction_rating AS FLOAT)) AS avg_satisfaction,
    MIN(a.session_date) AS first_appointment,
    MAX(a.session_date) AS last_appointment
FROM doctor d
LEFT JOIN appointment a ON d.doctor_id = a.doctor_id
GROUP BY d.d_name, d.spec;
GO

